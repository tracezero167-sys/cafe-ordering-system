# Database
# For local development (SQLite - removed for Vercel compatibility):
# DATABASE_URL="file:./dev.db"

# For PostgreSQL (production and Vercel deployment - REQUIRED):
DATABASE_URL="postgresql://user:password@host:5432/cafe_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-min-32-characters"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Razorpay (for production)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Pusher (for real-time updates)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="your_pusher_cluster"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="your_pusher_cluster"

# WhatsApp (optional - for notifications)
WHATSAPP_API_KEY="your_whatsapp_api_key"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
